# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Flask
SECRET_KEY=change-me-to-a-long-random-string

# Local toy database (default if no PostgreSQL config is provided)
SQLITE_PATH=unify_dev.db

# PostgreSQL (optional). Leave these blank for the local SQLite toy DB.
DB_NAME=
DB_USER=
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=

# Example PostgreSQL URL:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/conversations_db

# Anthropic Claude API key (required for /api/chat)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Legacy variable still supported by the backend if you already use it
CLAUD_API_TOKEN=
